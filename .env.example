NODE_ENV=development
PORT=4000

# Multi-document transactions require a replica set (Atlas, or a local `mongod --replSet rs0`).
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_saas?replicaSet=rs0

# Set to "false" ONLY for a standalone dev mongod. Without transactions, a crash between
# the stock $inc and the StockMovement insert can leave the ledger out of sync.
USE_TRANSACTIONS=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
