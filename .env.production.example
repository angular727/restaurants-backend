# Copy to .env.production and fill in. Used by docker-compose.yml (and by `npm start` if you
# export these variables yourself).
NODE_ENV=production
PORT=4000

# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Frontend origins allowed to call the API (comma-separated, exact scheme+host+port).
# Leave empty to block all browser access.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of reverse proxies in front of the API (nginx/Caddy/load balancer = 1, none = 0).
TRUST_PROXY=0

# Bundled MongoDB from docker-compose (host "mongo" on the private Docker network).
# For Atlas use: mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/restaurant_saas
MONGO_URI=mongodb://mongo:27017/restaurant_saas?replicaSet=rs0
USE_TRANSACTIONS=true

# Rate limits (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# Build indexes on container start (set false when running multiple API replicas)
SYNC_INDEXES_ON_START=true
